{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TigerMark default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "process:default",
    "updater:default",
    "allow-app-commands",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.pytiger.com" },
        { "url": "https://www.pytiger.com/*" }
      ]
    }
  ]
}
